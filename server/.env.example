# Server-side only (root `serve` for local, or `server/` for hosted). NEVER ship in the app bundle.
XAI_API_KEY=

# Optional for server/
# PORT=8787
# XAI_MODEL=grok-4.6
# CORS_ORIGINS=*

# Client production URL goes in www/config.js → OMNIFIT.scanApiBase (public HTTPS origin, not a secret).
# Example after you deploy: https://omnifit-scan.example.com
